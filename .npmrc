# Le peer optionnel `@sveltejs/kit` de `@vercel/analytics` impose SvelteKit, qui
# exige Vite 8 alors que ce projet est en Vite 5 (Vitest, @vitejs/plugin-react).
# L'application n'utilise jamais Svelte : on desactive donc la resolution des
# peers pour que `npm install` reste reproductible partout, Vercel compris.
legacy-peer-deps=true
