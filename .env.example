# ---------------------------------------------------------------------------
# TCF Simulator - variables d'environnement
# Copiez ce fichier vers `.env` puis adaptez les valeurs.
# ---------------------------------------------------------------------------

# --- Base de donnees -------------------------------------------------------
# Deux options possibles (voir README section "Base de donnees") :
#
# ATTENTION SUR VERCEL : DATABASE_PROVIDER doit valoir "postgresql" (option B),
# sur la portee "All Environments" — build ET execution. Vercel n'a pas de
# systeme de fichiers persistant : avec "sqlite", `prisma generate` embarque un
# client SQLite dans le bundle qui interroge ensuite Postgres, et chaque page
# lisant la base echoue avec « An error occurred in the Server Components
# render ». Le build s'interrompt maintenant sur ce cas, mais la valeur reste
# a regler a la main.
#
# A) SQLite (developpement local, aucun serveur requis)
DATABASE_PROVIDER="sqlite"
DATABASE_URL="file:./dev.db"
#
# B) PostgreSQL (production / Supabase / Neon / Railway)
# DATABASE_PROVIDER="postgresql"
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public&connection_limit=10"
#
# Supabase (option B) :
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
#
# Nécessaire uniquement avec l'adapter Prisma + Postgres (détaillés par `prisma db push`) :
# DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# --- Auth.js ---------------------------------------------------------------
# openssl rand -base64 32
AUTH_SECRET="remplacez-moi-par-un-secret-aleatoire-32-octets-minimum"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Connexion par e-mail + mot de passe
AUTH_EMAIL_ENABLED="true"

# Google OAuth (optionnel - laissez vide pour desactiver)
# Console Google Cloud > APIs et services > Identifiants > ID client OAuth
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Comptes de demonstration ---------------------------------------------
# Cree automatiquement par `npm run db:seed`
SEED_ADMIN_EMAIL="admin@tcf-simulator.local"
SEED_ADMIN_PASSWORD="Admin!2345"
SEED_DEMO_EMAIL="candidat@tcf-simulator.local"
SEED_DEMO_PASSWORD="Candidat!2345"

# --- Application -----------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="TCF Simulator"
# Identifiant du service worker (doit etre stable entre les deploiements)
NEXT_PUBLIC_SW_VERSION="v1"

# --- Base de contenu -------------------------------------------------------
# Chemin du JSON de base fourni pour l'import des 5 tests
TCF_SOURCE_JSON="data/tcf_practice_5_tests_250_questions.json"
# Publier automatiquement les tests au seed (true/false)
TCF_SEED_PUBLISH="true"
