{
  "name": "tcf-simulator",
  "version": "1.0.0",
  "private": true,
  "description": "Plateforme d'entrainement au TCF - 5 tests blancs, correction CECRL, analyse d'erreurs.",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/prisma.mjs generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:use:sqlite": "node scripts/db-switch.mjs sqlite",
    "db:use:postgres": "node scripts/db-switch.mjs postgres",
    "db:push": "node scripts/prisma.mjs db push",
    "db:migrate": "node scripts/prisma.mjs migrate dev",
    "db:deploy": "node scripts/prisma.mjs migrate deploy",
    "db:generate": "node scripts/prisma.mjs generate",
    "db:studio": "node scripts/prisma.mjs studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "node scripts/prisma.mjs db push --force-reset --skip-generate && npm run db:seed",
    "db:check": "node scripts/prisma.mjs validate",
    "icons:generate": "node scripts/generate-icons.mjs",
    "content:reading": "tsx scripts/apply-reading-content.ts",
    "content:reading:check": "tsx scripts/apply-reading-content.ts --check",
    "content:reading:verify": "tsx scripts/verify-reading-content.ts",
    "content:check": "tsx scripts/check-ce-content.ts",
    "content:encoding": "tsx scripts/check-ce-encoding.ts",
    "db:audit": "tsx scripts/audit-reading-db.mts",
    "import:tests": "tsx scripts/import-tests.ts",
    "import:csv": "tsx scripts/import-csv.ts",
    "export:csv": "tsx scripts/export-csv.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "verify": "npm run typecheck && npm run lint && npm run test"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@prisma/client": "5.22.0",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-progress": "^1.1.1",
    "@radix-ui/react-radio-group": "^1.2.2",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@tanstack/react-query": "^5.62.7",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.469.0",
    "next": "14.2.35",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "^3.26.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0",
    "server-only": "^0.0.1",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.17.10",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.35",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "prisma": "5.22.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
