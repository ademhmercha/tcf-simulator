// ---------------------------------------------------------------------------
// TCF Simulator - Prisma schema (CANONIQUE : PostgreSQL)
//
// Ce fichier est la source de verite unique. Pour travailler en local sans
// serveur Postgres, `npm run db:use:sqlite` genere automatiquement
// `prisma/schema.sqlite.prisma` a partir de celui-ci (memes modeles, seul le
// bloc `datasource` change). Revenez a Postgres avec `npm run db:use:postgres`.
//
// Choix de modelisation :
//  - Les "enums" Prisma sont des colonnes String + validation Zod (voir
//    config/enums.ts) afin que le schema fonctionne sur Postgres ET SQLite.
//  - Aucune annotation native `@db.*` n'est utilisee : cela garantit que la
//    generation du miroir SQLite est fiable.
//  - `SectionRun` materialise une tentative par epreuve : indispensable pour un
//    chronometre valide cote serveur et une reprise exacte apres rechargement.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------- Utilisateurs -------------------------------

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  emailVerified DateTime?
  name         String
  passwordHash String?
  image        String?
  /// USER | ADMIN
  role         String    @default("USER")
  /// fr | en | ar
  locale       String    @default("fr")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  attempts Attempt[]

  @@index([role])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ------------------------------- Contenu ---------------------------------

model Test {
  id          String   @id @default(cuid())
  /// Code externe issu du JSON source (ex: "test-01")
  code        String?  @unique
  title       String
  slug        String   @unique
  description String?
  order       Int      @default(1)
  isPublished Boolean  @default(false)
  /// duree totale indicative en minutes (somme des sections)
  durationMinutes Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sections Section[]
  attempts Attempt[]

  @@index([isPublished, order])
  @@map("tests")
}

model Section {
  id              String  @id @default(cuid())
  testId          String
  /// STRUCTURE | COMPREHENSION_ECRITE
  type            String
  title           String
  instructions    String?
  durationMinutes Int
  questionCount   Int
  order           Int     @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  test       Test         @relation(fields: [testId], references: [id], onDelete: Cascade)
  documents  Document[]
  questions  Question[]
  sectionRuns SectionRun[]

  @@index([testId, order])
  @@map("sections")
}

model Document {
  id        String   @id @default(cuid())
  sectionId String
  /// Code externe (ex: "T1-DOC01") - plusieurs questions pointent dessus
  code      String
  title     String
  content   String
  imageUrl  String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  section   Section    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  questions Question[]

  @@unique([sectionId, code])
  @@index([sectionId, order])
  @@map("documents")
}

model Question {
  id          String  @id @default(cuid())
  sectionId   String
  documentId  String?
  /// Code externe (ex: "ST1-01")
  code        String?
  number      Int
  prompt      String
  /// A1 | A2 | B1 | B2 | C1 | C2
  level       String
  category    String?
  points      Int     @default(1)
  explanation String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  section  Section   @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  document Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  options  Option[]
  answers  Answer[]

  @@unique([sectionId, code])
  @@index([sectionId, number])
  @@index([documentId])
  @@index([level])
  @@map("questions")
}

model Option {
  id         String  @id @default(cuid())
  questionId String
  /// A | B | C | D
  label      String
  text       String
  isCorrect  Boolean @default(false)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  Answer[]

  @@unique([questionId, label])
  @@index([questionId])
  @@map("options")
}

// ------------------------------ Passations --------------------------------

model Attempt {
  id                 String    @id @default(cuid())
  userId             String
  testId             String
  /// IN_PROGRESS | SUBMITTED | EXPIRED | ABANDONED
  status             String    @default("IN_PROGRESS")
  startedAt          DateTime  @default(now())
  finishedAt         DateTime?
  structureScore     Int?
  comprehensionScore Int?
  totalScore         Int?
  maxScore           Int?
  /// A1..C2
  cefrLevel          String?
  /// nom du barème utilisé au moment du calcul (traçabilité)
  scoringProfile     String?
  /// Pour une tentative « refaire uniquement mes erreurs » : liste JSON des
  /// identifiants de questions a retraiter. Null sur une tentative normale.
  focusedQuestionIds String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  test        Test         @relation(fields: [testId], references: [id], onDelete: Cascade)
  sectionRuns SectionRun[]
  answers     Answer[]

  @@index([userId, startedAt])
  @@index([testId, status])
  @@index([status])
  @@map("attempts")
}

model SectionRun {
  id         String    @id @default(cuid())
  attemptId  String
  sectionId  String
  /// IN_PROGRESS | SUBMITTED | EXPIRED
  status     String    @default("IN_PROGRESS")
  startedAt  DateTime  @default(now())
  /// Horodatage autoritaire de fin (calcule cote serveur, jamais côté client)
  expiresAt  DateTime
  finishedAt DateTime?
  score      Int?
  maxScore   Int?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  attempt Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, sectionId])
  @@index([expiresAt])
  @@map("section_runs")
}

model Answer {
  id               String   @id @default(cuid())
  attemptId        String
  questionId       String
  selectedOptionId String?
  isCorrect        Boolean  @default(false)
  flagged          Boolean  @default(false)
  timeSpentSec     Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  attempt  Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  option   Option?  @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
  @@map("answers")
}
