// ---------------------------------------------------------------------------
// TCF Simulator - Prisma schema (CANONIQUE : PostgreSQL)
//
// Ce fichier est la source de verite unique. Pour travailler en local sans
// serveur Postgres, `npm run db:use:sqlite` genere automatiquement
// `prisma/schema.sqlite.prisma` a partir de celui-ci (memes modeles, seul le
// bloc `datasource` change). Revenez a Postgres avec `npm run db:use:postgres`.
//
// Choix de modelisation :
//  - Les "enums" Prisma sont des colonnes String + validation Zod (voir
//    config/enums.ts) afin que le schema fonctionne sur Postgres ET SQLite.
//  - Aucune annotation native `@db.*` n'est utilisee : cela garantit que la
//    generation du miroir SQLite est fiable.
//  - `SectionRun` materialise une tentative par epreuve : indispensable pour un
//    chronometre valide cote serveur et une reprise exacte apres rechargement.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------- Utilisateurs -------------------------------

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  emailVerified DateTime?
  name         String
  passwordHash String?
  image        String?
  /// USER | ADMIN
  role         String    @default("USER")
  /// fr | en | ar
  locale       String    @default("fr")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  attempts Attempt[]
  auditLogs AuditLog[]
  listeningResults ListeningResult[]
  writingAttempts WritingAttempt[]
  testimonial Testimonial?

  @@index([role])
  @@map("users")
}

// ------------------------------ Avis candidats ----------------------------

/// Avis laisse par un candidat apres un examen. Un seul avis par compte
/// (modifiable) : toute modification repasse en PENDING. Rien n'est affiche
/// publiquement avant validation par un administrateur.
model Testimonial {
  id          String   @id @default(cuid())
  userId      String   @unique
  /// Nom affiche publiquement (prenom + initiale), choisi par le candidat.
  displayName String
  city        String?
  /// Niveau CECRL obtenu, declaratif (A1..C2), optionnel.
  level       String?
  /// Note de 1 a 5.
  rating      Int
  comment     String
  /// PENDING | APPROVED | REJECTED
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@map("testimonials")
}

// ------------------------- Journal d'administration -----------------------

/// Trace des actions sensibles de l'espace d'administration.
///
/// Le detail des reponses des candidats est masque par defaut : le deverrouiller
/// ecrit une ligne ici, ce qui permet de savoir QUI a consulte QUOI et QUAND.
/// `metadata` n'accueille que des identifiants et des compteurs, jamais le
/// contenu d'une reponse ni une donnee personnelle en clair.
model AuditLog {
  id       String @id @default(cuid())
  /// Administrateur auteur. `SetNull` : la trace survit a la suppression du
  /// compte auteur, sinon effacer un administrateur effacerait son historique.
  adminId  String?
  /// ADMIN_VIEW_ANSWERS | ADMIN_UPDATE_ROLE | ADMIN_DELETE_USER
  action   String
  /// Identifiant de la cible : userId pour une action sur un compte,
  /// attemptId pour une consultation de reponses.
  targetId String?
  /// JSON serialise : details non sensibles de l'action.
  metadata String?
  /// Adresse IP du client, pour correluer une action a une session.
  ip       String?
  createdAt DateTime @default(now())

  admin User? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([adminId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ------------------------------- Contenu ---------------------------------

model Test {
  id          String   @id @default(cuid())
  /// Code externe issu du JSON source (ex: "test-01")
  code        String?  @unique
  title       String
  slug        String   @unique
  description String?
  order       Int      @default(1)
  isPublished Boolean  @default(false)
  /// PRACTICE = serie d'entrainement (2 epreuves) | FULL = examen blanc
  /// complet (comprehension orale + structure + comprehension ecrite).
  /// Separation des catalogues : `/tests` ne liste que PRACTICE, `/examens`
  /// ne liste que FULL.
  kind        String   @default("PRACTICE")
  /// duree totale indicative en minutes (somme des sections)
  durationMinutes Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sections Section[]
  attempts Attempt[]

  @@index([isPublished, order])
  @@index([kind, isPublished, order])
  @@map("tests")
}

model Section {
  id              String  @id @default(cuid())
  testId          String
  /// STRUCTURE | COMPREHENSION_ECRITE
  type            String
  title           String
  instructions    String?
  durationMinutes Int
  questionCount   Int
  order           Int     @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  test       Test         @relation(fields: [testId], references: [id], onDelete: Cascade)
  documents  Document[]
  questions  Question[]
  sectionRuns SectionRun[]

  @@index([testId, order])
  @@map("sections")
}

model Document {
  id        String   @id @default(cuid())
  sectionId String
  /// Code externe (ex: "T1-DOC01") - plusieurs questions pointent dessus
  code      String
  title     String
  content   String
  imageUrl  String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  section   Section    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  questions Question[]

  @@unique([sectionId, code])
  @@index([sectionId, order])
  @@map("documents")
}

model Question {
  id          String  @id @default(cuid())
  sectionId   String
  documentId  String?
  /// Code externe (ex: "ST1-01")
  code        String?
  number      Int
  prompt      String
  /// A1 | A2 | B1 | B2 | C1 | C2
  level       String
  category    String?
  points      Int     @default(1)
  explanation String
  /// Comprehension orale : chemin public du fichier audio (ex:
  /// /audio/tests/test-01/03.mp3). Jamais envoye en correction avant la fin
  /// de l'epreuve, comme le reste du contenu.
  audioUrl    String?
  /// Comprehension orale : transcription exacte de l'audio. Sert aux
  /// corriges UNIQUEMENT : elle n'est jamais incluse dans le payload d'examen.
  transcription String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  section  Section   @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  document Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  options  Option[]
  answers  Answer[]

  @@unique([sectionId, code])
  @@index([sectionId, number])
  @@index([documentId])
  @@index([level])
  @@map("questions")
}

model Option {
  id         String  @id @default(cuid())
  questionId String
  /// A | B | C | D
  label      String
  text       String
  isCorrect  Boolean @default(false)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  Answer[]

  @@unique([questionId, label])
  @@index([questionId])
  @@map("options")
}

// ------------------------------ Passations --------------------------------

model Attempt {
  id                 String    @id @default(cuid())
  userId             String
  testId             String
  /// IN_PROGRESS | SUBMITTED | EXPIRED | ABANDONED
  status             String    @default("IN_PROGRESS")
  startedAt          DateTime  @default(now())
  finishedAt         DateTime?
  /// Nombre de bonnes reponses en comprehension orale (examens blancs).
  listeningScore     Int?
  structureScore     Int?
  comprehensionScore Int?
  totalScore         Int?
  maxScore           Int?
  /// A1..C2
  cefrLevel          String?
  /// nom du barème utilisé au moment du calcul (traçabilité)
  scoringProfile     String?
  /// Pour une tentative « refaire uniquement mes erreurs » : liste JSON des
  /// identifiants de questions a retraiter. Null sur une tentative normale.
  focusedQuestionIds String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  test        Test         @relation(fields: [testId], references: [id], onDelete: Cascade)
  sectionRuns SectionRun[]
  answers     Answer[]

  @@index([userId, startedAt])
  @@index([testId, status])
  @@index([status])
  // Series temporelles du tableau de bord admin (tentatives par jour/semaine).
  @@index([status, startedAt])
  // Fenetre de qualite du contenu : agregats sur les tentatives terminees
  // dans les N derniers jours.
  @@index([status, finishedAt])
  @@map("attempts")
}

model SectionRun {
  id         String    @id @default(cuid())
  attemptId  String
  sectionId  String
  /// IN_PROGRESS | SUBMITTED | EXPIRED
  status     String    @default("IN_PROGRESS")
  startedAt  DateTime  @default(now())
  /// Horodatage autoritaire de fin (calcule cote serveur, jamais côté client)
  expiresAt  DateTime
  finishedAt DateTime?
  score      Int?
  maxScore   Int?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  attempt Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, sectionId])
  @@index([expiresAt])
  @@map("section_runs")
}

model Answer {
  id               String   @id @default(cuid())
  attemptId        String
  questionId       String
  selectedOptionId String?
  isCorrect        Boolean  @default(false)
  flagged          Boolean  @default(false)
  timeSpentSec     Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  attempt  Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  option   Option?  @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
  // Qualite du contenu (taux de reussite par question) : index couvrant, evite
  // de revenir a la table pour chaque question.
  @@index([questionId, isCorrect])
  @@map("answers")
}

// ----------------------- Comprehension orale -----------------------------

/// Serie d'entrainement a la comprehension orale.
///
/// Independante des tests blancs : pas de chronometre, une ou plusieurs
/// ecoutes par audio (1 par defaut), correction immediate a la fin.
model ListeningSeries {
  id       String  @id @default(cuid())
  slug     String  @unique
  title    String
  /// A1 | A2 | B1 | B2 | C1 | C2 (ou palette melangee, ex: "B1-B2")
  level    String
  order    Int     @default(1)
  description String?
  /// Nombre d'ecoutes autorisees par fichier audio (le TCF officiel en offre deux).
  listenings Int   @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions ListeningQuestion[]
  results   ListeningResult[]

  @@index([level, order])
  @@map("listening_series")
}

model ListeningQuestion {
  id            String   @id @default(cuid())
  seriesId      String
  order         Int      @default(1)
  /// Chemin public du fichier audio (ex: /audio/co/<serie>/01.mp3)
  audioUrl      String
  transcription String
  prompt        String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  /// A | B | C | D
  correctLetter String
  explanation   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  series  ListeningSeries    @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  answers ListeningAnswer[]

  @@index([seriesId, order])
  @@map("listening_questions")
}

/// Resultat d'une serie de comprehension orale. Une ligne par passage :
/// retenter une serie cree une nouvelle ligne (historique de progression).
model ListeningResult {
  id        String   @id @default(cuid())
  userId    String
  seriesId  String
  score     Int
  maxScore  Int
  createdAt DateTime @default(now())

  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  series  ListeningSeries    @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  answers ListeningAnswer[]

  @@index([userId, createdAt])
  @@index([seriesId])
  @@map("listening_results")
}

model ListeningAnswer {
  id             String   @id @default(cuid())
  resultId       String
  questionId     String
  selectedLetter String?
  isCorrect      Boolean  @default(false)

  result   ListeningResult   @relation(fields: [resultId], references: [id], onDelete: Cascade)
  question ListeningQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([resultId])
  @@index([questionId])
  @@map("listening_answers")
}

// --------------------------- Expression ecrite ----------------------------

/// Sujet d'expression ecrite (epreuve TCF, 3 taches).
///
/// L'epreuve se passe sur papier : le site ne fournit QUE la consigne, le
/// chronometre, une feuille a imprimer et une auto-evaluation. Aucun texte
/// n'est saisi ni corrige par une IA.
model WritingPrompt {
  id           String  @id @default(cuid())
  slug         String  @unique
  /// 1 | 2 | 3 (tache de l'epreuve)
  task         Int
  /// B2 | C1 | C2
  level        String
  theme        String
  title        String
  instructions String
  /// JSON serialise : [{ author, text }] — les deux documents de la tache 3.
  documents    String  @default("[]")
  minWords     Int
  maxWords     Int
  durationMin  Int
  /// JSON serialise : plan en etapes.
  plan         String  @default("[]")
  /// JSON serialise : phrases types.
  usefulPhrases String @default("[]")
  /// JSON serialise : erreurs frequentes.
  commonMistakes String @default("[]")
  isPublished  Boolean @default(true)
  order        Int     @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  attempts WritingAttempt[]

  @@index([task, level])
  @@index([level])
  @@map("writing_prompts")
}

/// Tentative d'expression ecrite : un sujet, un temps passe, un nombre de
/// mots et l'auto-evaluation cochee par le candidat.
///
/// `selfScore` est un pourcentage de cases cochees : c'est un indicateur
/// d'entrainement, jamais une note officielle.
model WritingAttempt {
  id              String    @id @default(cuid())
  userId          String
  promptId        String
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?
  durationSeconds Int?
  wordCount       Int?
  /// JSON serialise : { <id de la checklist> : true }
  checklist       String    @default("{}")
  /// Pourcentage de cases cochees (0-100).
  selfScore       Int?
  notes           String?
  createdAt       DateTime  @default(now())

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt WritingPrompt @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([promptId])
  @@map("writing_attempts")
}
